{
  "name": "agent-chaos",
  "version": "0.1.0",
  "private": true,
  "description": "Fault injection toolkit for agent systems",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/agent-chaos.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/agent-chaos/issues"
  },
  "homepage": "https://github.com/reaatech/agent-chaos#readme",
  "keywords": [
    "chaos",
    "chaos-engineering",
    "fault-injection",
    "agent",
    "llm",
    "resilience",
    "testing"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "turbo run type-check",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.28.1",
    "@vitest/coverage-v8": "^3.2.4",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
