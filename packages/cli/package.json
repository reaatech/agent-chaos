{
  "name": "@reaatech/agent-chaos-cli",
  "version": "0.1.0",
  "description": "Command-line interface for agent-chaos",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/agent-chaos.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/reaatech/agent-chaos/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/reaatech/agent-chaos/issues"
  },
  "keywords": ["chaos", "chaos-engineering", "fault-injection", "cli", "agent"],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-chaos": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "build:watch": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "dev": "pnpm build:watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/agent-chaos-core": "workspace:*",
    "@reaatech/agent-chaos-scenarios": "workspace:*",
    "commander": "^14.0.3",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
