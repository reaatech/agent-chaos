{
  "name": "@agent-chaos/cli",
  "version": "0.1.0",
  "description": "Command-line interface for agent-chaos",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/agent-chaos.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/reaatech/agent-chaos#readme",
  "bugs": {
    "url": "https://github.com/reaatech/agent-chaos/issues"
  },
  "keywords": [
    "chaos",
    "chaos-engineering",
    "fault-injection",
    "cli",
    "agent"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-chaos": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "build:watch": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "dev": "pnpm build:watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-chaos/core": "workspace:*",
    "@agent-chaos/scenarios": "workspace:*",
    "commander": "^14.0.3",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
