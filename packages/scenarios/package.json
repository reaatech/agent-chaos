{
  "name": "@reaatech/agent-chaos-scenarios",
  "version": "0.1.0",
  "description": "Scenario loader and validator for agent-chaos",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/agent-chaos.git",
    "directory": "packages/scenarios"
  },
  "homepage": "https://github.com/reaatech/agent-chaos/tree/main/packages/scenarios#readme",
  "bugs": {
    "url": "https://github.com/reaatech/agent-chaos/issues"
  },
  "keywords": [
    "chaos",
    "chaos-engineering",
    "fault-injection",
    "scenarios",
    "yaml",
    "agent"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./templates/*": "./src/templates/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --shims --clean && node -e \"require('fs').cpSync('src/schemas', 'dist/schemas', {recursive:true})\"",
    "build:watch": "tsup src/index.ts --format esm,cjs --dts --sourcemap --shims --watch",
    "dev": "pnpm build:watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/agent-chaos-core": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
